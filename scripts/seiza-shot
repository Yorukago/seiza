#!/bin/sh
# seiza-shot [area|screen]: grim (+ slurp) -> ~/Pictures/Screenshots, also on the clipboard.
# seiza-shot record [area|screen]: wf-recorder -> ~/Videos/Recordings; run it again to stop.
if [ "$1" = record ]; then
	pidf="${XDG_RUNTIME_DIR:-/tmp}/seiza-record.pid"
	if [ -f "$pidf" ] && kill -0 "$(cat "$pidf")" 2>/dev/null; then
		kill -INT "$(cat "$pidf")" # the first run notices and finishes up
		exit 0
	fi
	vdir="${XDG_VIDEOS_DIR:-$HOME/Videos}/Recordings"
	mkdir -p "$vdir"
	v="$vdir/seiza-$(date +%Y%m%d-%H%M%S).mp4"
	case "${2:-area}" in
	area) g=$(slurp) || exit 0; set -- -g "$g" ;;
	screen) set -- ;;
	*) echo "usage: seiza-shot record [area|screen]" >&2; exit 2 ;;
	esac
	set -m # job control, or a background job ignores the SIGINT that stops it
	wf-recorder "$@" -f "$v" &
	echo $! > "$pidf"
	notify-send "Recording" "run it again to stop" 2>/dev/null
	wait $!
	rm -f "$pidf"
	notify-send "Recording saved" "$v" 2>/dev/null
	exit 0
fi
dir="${XDG_PICTURE_DIR:-$HOME/Pictures}/Screenshots"
mkdir -p "$dir"
f="$dir/seiza-$(date +%Y%m%d-%H%M%S).png"
case "${1:-area}" in
area) g=$(slurp) || exit 0; grim -g "$g" "$f" ;;
screen) grim "$f" ;;
*) echo "usage: seiza-shot [area|screen]" >&2; exit 2 ;;
esac || exit 1
wl-copy < "$f"
notify-send -i "$f" "Screenshot saved" "$f" 2>/dev/null
exit 0
