#!/bin/sh
# Keeps the last 50 text copies in $XDG_RUNTIME_DIR/seiza-clip (tmpfs, so a copied password is gone at logout).
# The picker pins an entry by renaming <ms>.txt to <ms>.pin: those are never pruned, and copying one again
# (pasting from the picker) does not add a second copy.
# Autostarted as `wl-paste --type text --watch seiza-clip-store`; the text arrives on stdin. Alt+v picks one.
d=${XDG_RUNTIME_DIR:-/tmp}/seiza-clip
mkdir -p -m 700 "$d"
new=$(mktemp "$d/.new.XXXXXX")
cat > "$new"
# A copy marked sensitive (`wl-copy --sensitive`, as seiza-pass does) never reaches the history.
if wl-paste --list-types 2>/dev/null | grep -qx x-kde-passwordManagerHint; then rm -f "$new"; exit 0; fi
newest=$(ls "$d" | sort | tail -n 1)
dup=
for f in "$d"/*.pin; do [ -e "$f" ] && cmp -s "$new" "$f" && dup=1; done
if grep -q '[^[:space:]]' "$new" && [ -z "$dup" ] && ! { [ -n "$newest" ] && cmp -s "$new" "$d/$newest"; }; then
	mv "$new" "$d/$(date +%s%3N).txt"
else
	rm -f "$new"
fi
ls "$d" | grep '\.txt$' | sort | head -n -50 | while read -r f; do rm -f "$d/$f"; done
