#!/bin/sh
# Keeps the last 50 text copies in $XDG_RUNTIME_DIR/seiza-clip (tmpfs, so a copied password is gone at logout).
# Autostarted as `wl-paste --type text --watch seiza-clip-store`; the text arrives on stdin. Alt+v picks one.
d=${XDG_RUNTIME_DIR:-/tmp}/seiza-clip
mkdir -p -m 700 "$d"
new=$(mktemp "$d/.new.XXXXXX")
cat > "$new"
newest=$(ls "$d" | sort | tail -n 1)
if grep -q '[^[:space:]]' "$new" && ! { [ -n "$newest" ] && cmp -s "$new" "$d/$newest"; }; then
	mv "$new" "$d/$(date +%s%3N).txt"
else
	rm -f "$new"
fi
ls "$d" | sort | head -n -50 | while read -r f; do rm -f "$d/$f"; done
